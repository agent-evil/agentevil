---
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
interface Props { name: 'sliders-horizontal'|'arrow-up-right'|'arrow-right'|'x'|'magnifying-glass'|'globe'|'t-shirt'|'sun'|'moon'|'translate'|'github-logo'|'planet'|'eye-slash'|'eyeglasses'|'radio'|'book-open'|'rss'|'check'|'headphones'|'arrow-left'; size?: number; }
const { name, size = 20 } = Astro.props;
const require=createRequire(import.meta.url);
const file=require.resolve(`@phosphor-icons/core/assets/regular/${name}.svg`);
const svg=readFileSync(file,'utf8').replace('<svg ',`<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `);
---
<Fragment set:html={svg} />

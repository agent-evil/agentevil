---
import {copy,path,type Lang} from '../lib/i18n';
import {getPosts,postText} from '../lib/content';
import Icon from './Icon.astro';
interface Props {lang:Lang;}
const {lang}=Astro.props;const t=copy[lang];const posts=await getPosts(lang);const lead=postText(posts[0],lang);
const featured=[['eacc','e/acc', ['Accelerate first. Debate later.','先加速，再辩论。','Accélérer. Débattre ensuite.']],['dacc','d/acc',['Progress, with a defense budget.','进步，也要带上防御。','Le progrès, avec des défenses.']],['evidence-centrism', ['Evidence-first centrism','证据中心主义','Le centrisme fondé sur les preuves'][lang==='en'?0:lang==='zh'?1:2],['Including our own blind spots.','当然也包括我们的盲点。','Y compris nos propres angles morts.']]] as const;
---
<div class="top-strap"><span class="micro onair">{t.onair}</span><span class="micro">{t.tagline}</span><span class="micro">EST. 2026</span></div>
<div class="masthead" aria-label="Agent Evil"><span>AGENT</span><span>EVIL</span></div>
<div class="manifesto-strap"><p>{t.thesis} <strong>{t.thesis2}</strong></p><p>{t.issue}</p></div>
<section class="lead" aria-labelledby="lead-title"><div class="lead-copy"><p class="eyebrow">{t.latest}</p><h1 class="hero-title" id="lead-title"><a href={path(lang,`posts/${lead.slug}/`)}>{lead.title}</a></h1><p class="deck">{lead.description}</p><div class="meta"><span>{t.operator}</span><span>{lead.minutes} {t.min}</span><span>{lead.kicker}</span></div><a class="button-link" href={path(lang,`posts/${lead.slug}/`)}>{t.read}<Icon name="arrow-up-right"/></a></div><div class="lead-visual"><figure><img class="lead-art" src="/images/yeti-broadcast-neutral.webp" srcset="/images/yeti-broadcast-neutral-small.webp 640w, /images/yeti-broadcast-neutral.webp 1100w" sizes="(max-width:760px) 95vw, 45vw" width="1100" height="733" fetchpriority="high" alt={lang==='zh'?'一只挑着眉毛的毛茸茸雪怪，正在麦克风前一本正经地广播。':lang==='fr'?'Un yéti hirsute, sourcils froncés, très sérieux derrière son micro de radio.':'A shaggy, slightly sinister yeti taking his pirate radio broadcast very seriously.'}/><figcaption class="art-caption"><span>AGENT EVIL · {lang==='zh'?'邪体':lang==='fr'?'LE YÉTI':'THE YETI'}</span><span>{t.illustration}</span></figcaption></figure><aside class="hero-heckle" data-evil><div class="voice-label"><span class="yeti-glyph" aria-hidden="true"><i></i></span>{t.commentary}</div><p>“{lead.note}”</p></aside></div></section>
<section aria-labelledby="latest-heading"><div class="section-heading"><h2 class="section-label" id="latest-heading">{t.more}</h2><a class="text-link" href={path(lang,'posts/')}>{t.all}<Icon name="arrow-right" size={17}/></a></div><div class="editorial-columns"><div>{[posts[2],posts[3],posts[5]].map(post=>{const p=postText(post,lang);return <a class="story-row" href={path(lang,`posts/${p.slug}/`)}><div><span class="eyebrow">{p.kicker}</span><h3>{p.title}</h3><p>{p.description}</p><div class="meta"><span>{t[p.narrator]}</span><span>{p.minutes} {t.min}</span></div></div><Icon name="arrow-up-right" size={24}/></a>})}</div><div>{[posts[4],posts[1]].map(post=>{const p=postText(post,lang);return <article class="side-feature"><p class="eyebrow">{p.kicker}</p><h3><a href={path(lang,`posts/${p.slug}/`)}>{p.title}</a></h3><p>{p.description}</p><div class="meta"><span>{t[p.narrator]}</span><span>{p.minutes} {t.min}</span></div></article>})}<div class="side-feature"><p class="eyebrow">{t.file}</p><h3>{t.origin}</h3><p>{t.originText}</p><a class="text-link" href={path(lang,'incident/')}>{t.incident}<Icon name="arrow-up-right" size={17}/></a></div></div></div></section>
<section class="atlas-feature"><div><p class="eyebrow">{t.atlasEyebrow}</p><h2>{t.atlasTitle}</h2><p class="deck">{t.atlasIntro}</p><a class="text-link" style="margin-top:24px" href={path(lang,'atlas/')}>{t.explore}<Icon name="arrow-right"/></a></div><div class="atlas-paths">{featured.map(([slug,title,sub])=><a href={path(lang,`atlas/${slug}/`)}><span>{title}<small>{sub[lang==='en'?0:lang==='zh'?1:2]}</small></span><Icon name="arrow-up-right"/></a>)}</div></section>
